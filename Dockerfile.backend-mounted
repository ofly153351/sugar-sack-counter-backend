FROM node:20-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

EXPOSE 3001

CMD ["sh", "-c", "npm ci --include=dev --no-audit --prefer-offline && npx prisma generate && npm run build && node dist/main.js"]
