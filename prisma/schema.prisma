generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  users       User[]

  @@map("roles")
}

model User {
  id               String                @id @default(uuid())
  roleId           String                @map("role_id")
  username         String                @unique
  password         String
  email            String                @unique
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at")
  boxSessions      BoxCountingSession[]
  countingSessions CountingSession[]
  sackSessions     SackCountingSession[]
  profile          UserProfile?
  role             Role                  @relation(fields: [roleId], references: [id])

  @@map("users")
}

model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  title        String
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  phone        String?
  position     String?
  employeeCode String?  @unique @map("employee_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model VehicleType {
  id          String    @id @default(uuid())
  name        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  vehicles    Vehicle[]

  @@map("vehicle_types")
}

model Vehicle {
  id               String                @id @default(uuid())
  vehicleCode      String                @unique @map("vehicle_code")
  licensePlate     String                @unique @map("license_plate")
  vehicleTypeId    String                @map("vehicle_type_id")
  driverName       String                @map("driver_name")
  status           String                @default("active")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at")
  boxSessions      BoxCountingSession[]
  countingSessions CountingSession[]
  sackSessions     SackCountingSession[]
  vehicleType      VehicleType           @relation(fields: [vehicleTypeId], references: [id])

  @@map("vehicles")
}

model SugarType {
  id               String                @id @default(uuid())
  name             String
  productCode      String?               @map("description")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at")
  boxSessions      BoxCountingSession[]
  countingSessions CountingSession[]
  sackSessions     SackCountingSession[]

  @@map("sugar_types")
}

model SackCountingSession {
  id              String           @id @default(uuid())
  vehicleId       String           @map("vehicle_id")
  sugarTypeId     String           @map("sugar_type_id")
  userId          String           @map("user_id")

  countingDate    DateTime         @default(now()) @map("counting_date")
  status          String           @default("completed")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  countingSession CountingSession?
  sugarType       SugarType        @relation(fields: [sugarTypeId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id])
  sackRows        SackRow[]

  @@map("sack_counting_sessions")
}

model SackRow {
  id                 String              @id @default(uuid())
  sessionId          String              @map("session_id")
  rowNumber          Int                 @map("row_number")
  weightType         String              @map("weight_type")
  aiCount            Int?                @map("ai_count")
  finalCount         Int                 @map("final_count")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")
  annotatedImagePath String?             @map("annotated_image_path")
  originalImagePath  String?             @map("original_image_path")
  session            SackCountingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("sack_rows")
}

model BoxCountingSession {
  id              String           @id @default(uuid())
  vehicleId       String           @map("vehicle_id")
  sugarTypeId     String           @map("sugar_type_id")
  userId          String           @map("user_id")

  countingDate    DateTime         @default(now()) @map("counting_date")
  status          String           @default("completed")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  sugarType       SugarType        @relation(fields: [sugarTypeId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id])
  boxRows         BoxRow[]
  countingSession CountingSession?

  @@map("box_counting_sessions")
}

model BoxRow {
  id                 String             @id @default(uuid())
  sessionId          String             @map("session_id")
  rowNumber          Int                @map("row_number")
  aiCount            Int?               @map("ai_count")
  finalCount         Int                @map("final_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  annotatedImagePath String?            @map("annotated_image_path")
  originalImagePath  String?            @map("original_image_path")
  session            BoxCountingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("box_rows")
}

model CountingSession {
  id            String               @id @default(uuid())
  sessionType   String               @map("session_type")
  sackSessionId String?              @unique @map("sack_session_id")
  boxSessionId  String?              @unique @map("box_session_id")
  userId        String               @map("user_id")
  vehicleId     String               @map("vehicle_id")
  sugarTypeId   String               @map("sugar_type_id")
  totalCount    Int                  @default(0) @map("total_count")
  totalWeight   Float?               @default(0) @map("total_weight")
  countingDate  DateTime             @default(now()) @map("counting_date")
  status        String               @default("completed")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at")
  boxSession    BoxCountingSession?  @relation(fields: [boxSessionId], references: [id])
  sackSession   SackCountingSession? @relation(fields: [sackSessionId], references: [id])
  sugarType     SugarType            @relation(fields: [sugarTypeId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
  vehicle       Vehicle              @relation(fields: [vehicleId], references: [id])

  @@map("counting_sessions")
}
